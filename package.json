{
  "name": "glovo-export",
  "version": "1.0.0",
  "description": "Export your Glovo and Amazon order history to JSON — locally, in your own browser",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "login": "tsx src/cli.ts login",
    "export": "tsx src/cli.ts export",
    "amazon:login": "tsx src/cli.ts amazon:login",
    "amazon:probe": "tsx src/cli.ts amazon:probe",
    "amazon:export": "tsx src/cli.ts amazon:export",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  }
}
